# ---- Telegram -------------------------------------------------------------
# From @BotFather -> /newbot. Username MUST end in "bot".
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here
# Any random string; it becomes part of the webhook path.
WEBHOOK_SECRET=change-me-to-something-random
USE_WEBHOOK=true

# ---- Public hosting -------------------------------------------------------
# The https URL of THIS service. On Render, RENDER_EXTERNAL_URL is auto-set and
# used as a fallback, but setting it explicitly is safer.
PUBLIC_BASE_URL=https://your-service.onrender.com

# ---- LLM (OpenAI-compatible) ---------------------------------------------
# AIPipe (IITM):  https://aipipe.org/openai/v1   with your aipipe token
# OpenAI direct:  https://api.openai.com/v1
# OpenRouter:     https://aipipe.org/openrouter/v1
LLM_BASE_URL=https://aipipe.org/openai/v1
LLM_API_KEY=your-aipipe-or-openai-token
LLM_MODEL=gpt-4.1-mini
LLM_FALLBACK_MODEL=gpt-4.1-mini

# ---- Web search (optional but strongly recommended) -----------------------
# Without a key the agent falls back to scraping DuckDuckGo, which works but is
# flaky and rate-limited. A real key makes dataset questions far more reliable.
# Tavily:  https://tavily.com  (free tier, 1000 searches/month)
# Brave:   https://brave.com/search/api  (free tier, 2000 queries/month)
# Set either one; Tavily is tried first.
TAVILY_API_KEY=
BRAVE_API_KEY=

# ---- Budgets --------------------------------------------------------------
# Grader allows 300s for the WHOLE exchange; keep a single turn well under it.
TURN_DEADLINE_SECONDS=150
MAX_TOOL_CALLS=18
SANDBOX_TIMEOUT_SECONDS=45
LOG_DIR=logs
LOG_LEVEL=INFO
